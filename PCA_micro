def analyze_and_save_pca(
    df, output_dir="output", graph_name="pca_variance.png", csv_name="pca_loadings.csv"
):
    """高次元のデータに対してPCAを実行し、累積寄与率のグラフと因子負荷量の表を保存する関数。

    Parameters:
    df (pd.DataFrame): 分析対象のデータフレーム（数値データのみ）
    output_dir (str): ファイルを保存するディレクトリのパス
    graph_name (str): 保存するグラフのファイル名 (.png)
    csv_name (str): 保存する因子負荷量のファイル名 (.csv)
    """
    # 0. 保存先ディレクトリの作成（存在しない場合は自動作成）
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
        print(f"ディレクトリを作成しました: {output_dir}")

    # 1. PCAの実行
    # 特徴量の数と同じ数だけ主成分を計算します
    n_components = df.shape[0]
    pca = PCA(n_components=n_components)
    pca.fit(df)

    # ss = StandardScaler()
    # df_scaled = pd.DataFrame(ss.fit_transform(df), columns=df.columns)

    #X_pca = pca.transform(df_scaled)
    X_pca = pca.transform(df)

    # 2. 累積寄与率の計算とグラフ保存
    # 各主成分の寄与率を取得し、累積和を計算します
    explained_variance_ratio = pca.explained_variance_ratio_
    cumulative_variance_ratio = np.cumsum(explained_variance_ratio)

    # グラフの描画
    plt.figure(figsize=(8, 5))
    # 累積寄与率を折れ線グラフでプロット
    plt.plot(
        range(1, n_components + 1),
        cumulative_variance_ratio,
        marker="o",
        linestyle="--",
        label="Cumulative",
    )
    # 各主成分単体の寄与率を棒グラフでプロット
    plt.bar(
        range(1, n_components + 1), explained_variance_ratio, alpha=0.5, label="Individual"
    )

    plt.xlabel("Principal Components (Dimensions)")
    plt.ylabel("Explained Variance Ratio")
    plt.title("PCA Explained Variance")
    plt.xticks(range(1, n_components + 1))
    plt.grid(True, linestyle=":", alpha=0.6)
    plt.legend(loc="best")

    # グラフをPNGとして保存
    graph_path = os.path.join(output_dir, graph_name)
    plt.savefig(graph_path, dpi=300, bbox_inches="tight")
    plt.close()  # メモリ解放のためにグラフを閉じる
    print(f"累積寄与率のグラフを保存しました: {graph_path}")

    # 3. 因子負荷量の計算とCSV保存
    # 因子負荷量 = 固有ベクトルの各成分 × 主成分の標準偏差（固有値の平方根）
    # pca.components_ は (主成分数, 特徴量数) の形状なので、転置(.T)して (特徴量数, 主成分数) にします
    loadings = pca.components_.T * np.sqrt(pca.explained_variance_)

    # 列名（カラム名）を 'PC1', 'PC2', ... に設定
    columns = [f"PC{i}" for i in range(1, n_components + 1)]

    # データフレームにまとめる（インデックスは元の特徴量名）
    loadings_df = pd.DataFrame(loadings, index=df.columns, columns=columns)

    PCA_df = pd.DataFrame(X_pca, columns=columns)
    csv_path = os.path.join(output_dir, 'PCA_result.csv')
    PCA_df.to_csv(csv_path)

    # CSVとして保存
    csv_path = os.path.join(output_dir, csv_name)
    loadings_df.to_csv(csv_path)
    print(f"因子負荷量の表を保存しました: {csv_path}")

    return loadings_df, PCA_df

import pandas as pd
from scipy import stats


def filter_significant_features(X, Y, alpha=0.05):
    """Xの各特徴量とYの間でスピアマンの相関検定を行い、有意な特徴量のみを抽出する関数。

    Parameters:
    -----------
    X : pandas.DataFrame
        特徴量が含まれるデータフレーム
    Y : pandas.Series or array-like
        ターゲット（目的変数）のデータ
    alpha : float, default 0.05
        有意水準（この値よりp値が小さければ有意とみなす）

    Returns:
    --------
    pandas.DataFrame
        有意な相関が見られた特徴量のみで構成された新しいデータフレーム
    """
    # 有意と判定された列名を保存するためのリスト
    significant_columns = []

    # Xの各列（特徴量）についてループ処理を行う
    for col in X.columns:
        # scipyのspearmanrを使って、相関係数(correlation)とp値(p_value)を計算
        # nan_policy='omit' を指定することで、欠損値がある場合は除外して計算します
        correlation, p_value = stats.spearmanr(
            X[col], Y, nan_policy="omit"
        )

        # p値が有意水準(alpha)未満であるかチェック
        if p_value < alpha:
            significant_columns.append(col)

    # 有意な列だけを抽出した新しいデータフレームを返す
    return X[significant_columns]

import os
import pandas as pd
from scipy import stats  # 統計計算のためのライブラリを追加

def save_spearman_corr_with_pvalue(
    X: pd.DataFrame,
    Y: pd.DataFrame,
    label_col: str,
    target_col: str,
    save_dir: str,
    file_name: str = "spearman_pvalue_results.csv",
):
    """pandas形式のデータから、ラベルごとにスピアマン相関係数とp値を計算し、

    特徴量名をインデックスとしてCSVで保存する関数。
    """
    # 1. XとYの一部の列を結合して、処理しやすい1つの表にします
    combined_df = pd.concat([X, Y[[label_col, target_col]]], axis=1)

    # 結果を格納するための空の辞書
    results_dict = {}

    # 2. 指定されたラベル列でデータをグループ分けします
    grouped = combined_df.groupby(label_col)

    for label_name, group_data in grouped:
        # このラベルにおける目的変数
        Y_target = group_data[target_col]

        # 相関係数（rho）とp値を格納するための仮の辞書（このラベル専用）
        rho_dict = {}
        p_dict = {}

        # Xの各特徴量を1つずつループ処理して計算します
        for feature in X.columns:
            X_feature = group_data[feature]

            # scipyを使ってスピアマン相関係数とp値を計算
            # データの欠損値(NaN)がある場合は自動で除外して計算します
            rho, p_value = stats.spearmanr(
                X_feature, Y_target, nan_policy="omit"
            )

            # 特徴量名をキーにして結果を記録
            rho_dict[feature] = rho
            p_dict[feature] = p_value

        # カラム名を指定の形式（{ラベル名}_rho, {ラベル名}_p）にして全体の辞書に追加
        results_dict[f"{label_name}_rho"] = pd.Series(rho_dict)
        results_dict[f"{label_name}_p"] = pd.Series(p_dict)

    # 3. 辞書から最終的なDataFrame（表）を作成
    final_df = pd.DataFrame(results_dict)

    # 保存先ディレクトリの存在チェックと自動作成
    if not os.path.exists(save_dir):
        os.makedirs(save_dir)
        print(f"ディレクトリを作成しました: {save_dir}")

    # CSVファイルとして保存
    save_path = os.path.join(save_dir, file_name)
    final_df.to_csv(save_path, index=True)

    print(f"無事にp値付きのCSVファイルが保存されました: {save_path}")
    return final_df

